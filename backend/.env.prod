# 9XAIPal — production server environment
# ---------------------------------------------------------------------------
# Copy to .env and fill in the two REQUIRED secrets, then:
#   docker compose -f docker-compose.prod.yml up -d --build
#
# The API + workers run in this compose stack. Public traffic enters through
# nginx, installed directly on the host (not managed by this compose file —
# see backend/nginx/9xaipal.conf) which serves the built SPA and reverse-
# proxies /api to this stack.
# ---------------------------------------------------------------------------

# ── REQUIRED: your Ollama Cloud API key ────────────────────────────────────
# Get it at https://ollama.com/settings/keys. Used for chat and vision (OCR).
OLLAMA_API_KEY=

# ── Embeddings ─────────────────────────────────────────────────────────────
# The Ollama Cloud key above covers chat and vision but returns "unauthorized"
# for every embedding model, so embeddings run on the Ollama installed
# directly on this host instead (pull it once: `ollama pull qwen3-embedding:0.6b`).
#
# Pin the provider EXPLICITLY. With "auto" the resolver probes Ollama first,
# finds https://ollama.com reachable, picks it, and then fails on every embed.
#
# qwen3-embedding:0.6b is 1024-dim, matching VECTOR_DIMENSION exactly — no
# truncation or padding needed.
EMBEDDING_PROVIDER=custom
EMBEDDING_BASE_URL=http://host.docker.internal:11434/v1
EMBEDDING_MODEL=qwen3-embedding:0.6b

# Embeddings are only generated when the full ingest profile runs. With the
# default "fast" profile the ASK/GLOBAL path has nothing to search, and
# full-text search alone cannot answer natural-language questions (Postgres
# websearch_to_tsquery ANDs every term, so a whole question matches nothing).
INGEST_PROFILE=full

# ── REQUIRED: a strong Postgres password (change the default!) ──────────────
POSTGRES_PASSWORD=change-me-to-a-long-random-string

# ── AI models (all via Ollama Cloud, using OLLAMA_API_KEY above) ───────────
# Chat: gemma4:31b is what this account's Ollama Cloud key actually exposes.
CHAT_MODEL=gemma4:31b
# Vision — figure descriptions and any VLM-based chat, NOT PDF extraction
# (this deployment runs local MinerU for that; see the extraction section
# below). NOTE: qwen3-vl:235b was RETIRED by Ollama on 2026-06-16 and now
# errors. gemma4:31b is multimodal and verified to transcribe a real paper
# page correctly, so it serves as both chat and vision model here.
VLM_MODEL=gemma4:31b
# Stored embedding dimension (see the embedding block near the top for the
# model). Vectors smaller than this are zero-padded, larger ones truncated and
# re-normalised. Keep <= 2000: pgvector's HNSW index has a hard 2000 limit.
VECTOR_DIMENSION=1024
EMBED_MAX_CHARS=3000

# ── Host ports (VM side) ───────────────────────────────────────────────────
API_PORT=8000
REDIS_PORT=6379
POSTGRES_PORT=5432

# ── CORS: which browser origins may call this API ──────────────────────────
# nginx serves the SPA and proxies /api same-origin, so this is normally
# empty. Set it only if a separately-hosted frontend needs to call this API.
CORS_ORIGINS=

# ── Upload / extraction tuning ─────────────────────────────────────────────
MAX_UPLOAD_SIZE_MB=100
# PDF extraction runs local MinerU (celery_worker's Dockerfile.mineru build).
# Optional Hugging Face token so the model-download step (runs at Docker BUILD
# time, not container start) doesn't hit anonymous rate limits on the ~5GB
# weight download. Get one at https://huggingface.co/settings/tokens — "Read"
# access is enough.
HF_TOKEN=
# Extracts large documents in page-range batches: bounds peak RAM (an
# unbatched extraction of a huge book can OOM-kill the worker), and doubles
# as the granularity of the extraction-progress reporting the UI shows.
# 0 disables batching.
MINERU_PAGE_BATCH_SIZE=100
ALLOW_PYMUPDF_FALLBACK=true
# Caps celery_worker's own memory so a huge PDF OOMs only that one container
# (which then auto-restarts) instead of pressuring postgres/redis/api on the
# same box. This box has 11GB total and no swap — leave enough headroom for
# everything else (postgres, redis, api, autoheal, OS, this host's own Ollama
# for embeddings) when raising it.
WORKER_MEM_LIMIT=7G

# ── DB pool (tune to the new server's cores/RAM) ────────────────────────────
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=15

# ── REQUIRED to let anyone sign up: shared invite-code secret ──────────────
# Give this to whoever you want to be able to create an account, out-of-band.
# Empty disables signup entirely (existing accounts can still log in).
SIGNUP_INVITE_CODE=
