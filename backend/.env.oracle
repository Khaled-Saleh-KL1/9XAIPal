# 9XAIPal — Oracle Cloud "Always Free" environment
# ---------------------------------------------------------------------------
# Copy to .env and fill in the two REQUIRED secrets, then:
#   docker compose -f docker-compose.oracle.yml up -d --build
#
# This runs the whole backend on the VM. The UI lives on Vercel and points
# here via VITE_API_BASE_URL (see the runbook in docs/).
# ---------------------------------------------------------------------------

# ── REQUIRED: your Ollama Cloud API key ────────────────────────────────────
# Get it at https://ollama.com/settings/keys. Used for chat, vision (OCR) and
# embeddings — everything AI runs on Ollama Cloud, so no local models needed.
OLLAMA_API_KEY=

# ── Embeddings ─────────────────────────────────────────────────────────────
# The Ollama Cloud key above covers chat and vision but returns "unauthorized"
# for every embedding model, so vector search needs another provider.
#
# Pin the provider EXPLICITLY. With "auto" the resolver probes Ollama first,
# finds https://ollama.com reachable, picks it, and then fails on every embed.
#
# DEFAULT (recommended): embed locally, on this VM.
#   Embeddings are the one call made per CHUNK rather than per question, so a
#   free cloud quota cannot absorb them — measured 2026-08-17, Gemini's free
#   tier returned HTTP 429 after ~5 batched requests, about a third of ONE
#   paper. A local model has no quota and no per-token cost. all-minilm is
#   45 MB and 384-dim; the app zero-pads to VECTOR_DIMENSION, and zero-padding
#   does not change cosine similarity, so retrieval stays correct.
#   Requires the `ollama` service (see docker-compose.micro.yml).
EMBEDDING_PROVIDER=custom
EMBEDDING_BASE_URL=http://ollama:11434/v1
EMBEDDING_MODEL=all-minilm

# ALTERNATIVE: Google Gemini. Fine for querying, NOT for ingestion on the free
# tier (see above). Set EMBEDDING_PROVIDER=gemini, clear EMBEDDING_BASE_URL,
# set EMBEDDING_MODEL=gemini-embedding-001, and provide a key from
# https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Embeddings are only generated when the full ingest profile runs. With the
# default "fast" profile the ASK/GLOBAL path has nothing to search, and
# full-text search alone cannot answer natural-language questions (Postgres
# websearch_to_tsquery ANDs every term, so a whole question matches nothing).
INGEST_PROFILE=full

# ── REQUIRED: a strong Postgres password (change the default!) ──────────────
POSTGRES_PASSWORD=change-me-to-a-long-random-string

# ── REQUIRED: public HTTPS hostname for the API (Caddy + sslip.io) ──────────
# Use this VM's PUBLIC IP with dots replaced by dashes, then ".sslip.io" — it
# resolves to the IP with zero DNS setup, and Caddy auto-fetches a Let's
# Encrypt certificate for it. Example, for a VM whose public IP is
# 152.67.12.34:
#   CADDY_SITE_ADDRESS=152-67-12-34.sslip.io
# The Vercel frontend then uses  VITE_API_BASE_URL=https://<this host>
CADDY_SITE_ADDRESS=

# ── AI models (all via Ollama Cloud, using OLLAMA_API_KEY above) ───────────
# Chat: gemma4:31b is what this account's Ollama Cloud key actually exposes.
CHAT_MODEL=gemma4:31b
# Vision / OCR for PDF extraction (EXTRACTOR_PROVIDER=vlm).
# NOTE: qwen3-vl:235b was RETIRED by Ollama on 2026-06-16 and now errors.
# gemma4:31b is multimodal and verified to transcribe a real paper page
# correctly at 180 DPI, so it serves as both chat and vision model here.
VLM_MODEL=gemma4:31b
EXTRACTOR_VLM_MODEL=gemma4:31b
# Stored embedding dimension (see the embedding block near the top for the
# model). Vectors smaller than this are zero-padded, larger ones truncated and
# re-normalised. Keep <= 2000: pgvector's HNSW index has a hard 2000 limit.
VECTOR_DIMENSION=1024
EMBED_MAX_CHARS=3000

# ── Host ports (VM side) ───────────────────────────────────────────────────
API_PORT=8000
REDIS_PORT=6379
SEARXNG_PORT=8080
POSTGRES_PORT=5432

# ── CORS: which browser origins may call this API ──────────────────────────
# The Vercel production host plus its preview host pattern. Add your own
# domain here if you point a custom domain at the VM.
CORS_ORIGINS=https://9xaipal.vercel.app

# ── Upload / extraction tuning ─────────────────────────────────────────────
MAX_UPLOAD_SIZE_MB=100
EXTRACTOR_VLM_DPI=180
EXTRACTOR_VLM_MAX_PAGES=0
EXTRACTOR_VLM_CONCURRENCY=3
ALLOW_PYMUPDF_FALLBACK=true

# ── DB pool (4-core / 24 GB VM is comfortable with the defaults) ────────────
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=15
