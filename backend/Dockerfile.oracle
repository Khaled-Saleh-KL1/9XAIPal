# Backend image for the Oracle Always-Free ARM VM (linux/arm64).
#
# Differs from the default Dockerfile in two ways, both because this
# deployment runs EXTRACTOR_PROVIDER=vlm (PDF extraction happens on Ollama
# Cloud, not locally):
#
#   1. Installs requirements.oracle.txt — requirements.txt without
#      `mineru[core]`. Nothing in app/ imports MinerU; it is only ever shelled
#      out to, and on this deployment it is never invoked at all.
#   2. Drops the PyTorch CPU extra-index. With MinerU gone nothing pulls
#      torch, and that index carries few aarch64 wheels — leaving it in would
#      risk uv resolving to a wheel that does not exist for this platform.
#
# Every remaining dependency ships prebuilt manylinux aarch64 wheels, so the
# build is quick and needs no compiler for the Python packages themselves.

FROM python:3.11-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    UV_LINK_MODE=copy \
    UV_COMPILE_BYTECODE=1 \
    UV_HTTP_TIMEOUT=600

WORKDIR /app

COPY --from=ghcr.io/astral-sh/uv:0.10.8 /uv /uvx /bin/

# libpq for psycopg2/asyncpg, curl for the compose healthcheck.
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        build-essential \
        libpq-dev \
        curl \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.oracle.txt ./
RUN --mount=type=cache,target=/root/.cache/uv \
    uv pip install --system -r requirements.oracle.txt

COPY app ./app

# Compose overrides this for the Celery worker; default to the API.
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]
