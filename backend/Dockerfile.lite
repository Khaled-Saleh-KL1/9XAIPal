# The lightweight backend image — no MinerU, no torch. Used for the api
# service (PDF extraction is celery_worker's job alone, via Dockerfile.mineru;
# api never touches it) and mirrors what CI installs for the test suite.
#
# Differs from the default Dockerfile in two ways:
#
#   1. Installs requirements.lite.txt — requirements.txt without
#      `mineru[core]`. Nothing in app/ imports MinerU; it is only ever shelled
#      out to, by celery_worker alone.
#   2. Drops the PyTorch CPU extra-index. Nothing here pulls torch at all, so
#      there is no reason to carry an index for it.
#
# Every remaining dependency ships prebuilt manylinux wheels, so the build is
# quick and needs no compiler for the Python packages themselves.

FROM python:3.11-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    UV_LINK_MODE=copy \
    UV_COMPILE_BYTECODE=1 \
    UV_HTTP_TIMEOUT=600

WORKDIR /app

COPY --from=ghcr.io/astral-sh/uv:0.10.8 /uv /uvx /bin/

# libpq for psycopg2/asyncpg, curl for the compose healthcheck.
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        build-essential \
        libpq-dev \
        curl \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.lite.txt ./
RUN --mount=type=cache,target=/root/.cache/uv \
    uv pip install --system -r requirements.lite.txt

COPY app ./app

# Compose overrides this for the Celery worker; default to the API.
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]
