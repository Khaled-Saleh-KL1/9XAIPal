# The lightweight backend image — no MinerU, no torch. Used for the api
# service (PDF extraction is celery_worker's job alone, via Dockerfile.mineru;
# api never touches it) and mirrors what CI installs for the test suite.
#
# Installs the base dependency set from pyproject.toml/uv.lock, without the
# `mineru` extra — mineru[core] (and the torch/torchvision it pulls in) is
# the only thing this image skips. Every remaining dependency ships
# prebuilt manylinux wheels, so the build is quick and needs no compiler for
# the Python packages themselves.
#
# `uv sync` is the whole point of the lockfile: it diffs uv.lock against
# what's already installed and only fetches what changed, instead of
# `uv pip install`'s "reinstall everything in this list" every time — see
# uv.lock's own history for the CPU-torch-wheel index scoping this depends
# on (verified: torch.cuda.is_available() is False, zero nvidia-* packages
# anywhere, without the `mineru` extra selected here at all so it's moot for
# this image regardless).

FROM python:3.11-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    UV_LINK_MODE=copy \
    UV_COMPILE_BYTECODE=1 \
    UV_HTTP_TIMEOUT=600 \
    # Install into the system interpreter below, not a project-local .venv —
    # keeps `CMD`/`uvicorn`/`celery` working unprefixed, same as `uv pip
    # install --system` did before.
    UV_PROJECT_ENVIRONMENT=/usr/local

WORKDIR /app

COPY --from=ghcr.io/astral-sh/uv:0.10.8 /uv /uvx /bin/

# libpq for psycopg2/asyncpg, curl for the compose healthcheck.
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        build-essential \
        libpq-dev \
        curl \
    && rm -rf /var/lib/apt/lists/*

COPY pyproject.toml uv.lock ./
RUN --mount=type=cache,target=/root/.cache/uv \
    uv sync --locked --no-install-project

COPY app ./app

# Compose overrides this for the Celery worker; default to the API.
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]
