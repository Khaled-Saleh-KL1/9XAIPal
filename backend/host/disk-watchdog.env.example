# /etc/disk-watchdog.env — read by /usr/local/sbin/disk-watchdog. root:root 0600.
# SMTP_PASS is a Gmail App Password (https://myaccount.google.com/apppasswords),
# never the account password. OVH blocks outbound port 25; 587 + STARTTLS works.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@gmail.com
SMTP_PASS=
ALERT_TO=you@gmail.com
MOUNT=/
WARN_PERCENT=80
CRIT_PERCENT=90
